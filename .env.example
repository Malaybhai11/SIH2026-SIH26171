# Copy to .env (gitignored). The server loads this at startup.

# vlm | inception | anthropic | mock   (blank = auto-detect: VLM_BASE_URL first)
LLM_PROVIDER=vlm

# Open-weights vision-language model behind any OpenAI-compatible endpoint (recommended).
#   Ollama:  VLM_BASE_URL=http://localhost:11434/v1   VLM_MODEL=qwen2.5vl:7b
#   vLLM:    VLM_BASE_URL=http://localhost:8001/v1    VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
#   Cloud:   OpenRouter / Groq / Together host Llama-4-Scout, Qwen2.5-VL, Gemma-3
VLM_BASE_URL=http://localhost:11434/v1
VLM_MODEL=qwen2.5vl:7b
VLM_API_KEY=
# 0 = text-only model (the redacted screenshot is not attached)
VLM_IMAGES=1

# Inception Labs Mercury 2 (text-only diffusion LLM, OpenAI-compatible)
INCEPTION_API_KEY=
INCEPTION_MODEL=mercury-2
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1

# Anthropic (optional)
# ANTHROPIC_API_KEY=

# Record exactly what the server receives (privacy evidence): server/audit/
# AUDIT_LOG=1
# AUDIT_IMAGES=1

# Force the offline mock stepper
# MOCK_LLM=1
