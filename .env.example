# Copy to .env (gitignored) and fill in. The server loads this at startup.

# inception | anthropic | mock   (blank = auto-detect from whichever key is set)
LLM_PROVIDER=inception

# Inception Labs Mercury 2 (diffusion LLM, OpenAI-compatible, ~5-10x faster)
INCEPTION_API_KEY=
INCEPTION_MODEL=mercury-2
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1

# Anthropic Claude (alternative provider)
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5

# Force the offline mock stepper regardless of keys
# MOCK_LLM=1
