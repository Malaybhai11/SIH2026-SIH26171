# Build output
/dist/
/dist-firefox/

# Model weights: fetched by `npm run fetch-models` (clip_labels.json is generated from
# the 170 MB CLIP text tower, so it is committed)
/extension/models/**
!/extension/models/README.md
!/extension/models/clip_labels.json

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Env / secrets
.env
.env.*
!.env.example

# Eval artifacts (regenerated)
/eval/report.json
/eval/.cache/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# server audit logs (demo evidence, regenerated) — not the store.py module that writes them
/server/audit/*.jsonl
/server/audit/*.jsonl.*
/server/audit/*.jpg
/server/audit/__pycache__/

# deck renders
/docs/deck/*.jpg
